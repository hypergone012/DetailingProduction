{
  "name": "detailing-production",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dp/web dev",
    "build": "pnpm --filter @dp/web build",
    "preview": "pnpm --filter @dp/web preview",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p scripts && tsc -p tests",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "stack": "bash scripts/local/stack.sh",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "functions:vendor": "tsx scripts/dev/vendor-core.ts",
    "functions:check": "pnpm -s functions:vendor && deno check --config supabase/functions/deno.json supabase/functions/public-api/index.ts supabase/functions/owner-api/index.ts supabase/functions/notify-dispatcher/index.ts supabase/functions/assistant/index.ts server/gateway.ts server/configure.ts",
    "functions:serve": "pnpm -s functions:vendor && deno run --allow-net --allow-env --allow-read --allow-write=.local --config supabase/functions/deno.json server/gateway.ts",
    "tenant:new": "tsx scripts/tenant/cli.ts new",
    "tenant:validate": "tsx scripts/tenant/cli.ts validate",
    "tenant:publish": "tsx scripts/tenant/cli.ts publish",
    "tenant:verify": "tsx scripts/tenant/cli.ts verify",
    "tenant:shells": "tsx scripts/tenant/cli.ts shells",
    "tenant:remove": "tsx scripts/tenant/cli.ts remove",
    "tenant:art": "tsx scripts/tenant/demo-art.ts",
    "security:scan-bundle": "tsx scripts/security/scan-bundle.ts",
    "tenant:schema": "tsx scripts/tenant/cli.ts schema",
    "stack:env": "tsx scripts/local/env.ts",
    "push:vapid": "tsx -e \"import('@dp/core').then(async m => console.log(JSON.stringify(await m.generateVapidKeys(), null, 2)))\"",
    "deploy:step": "tsx scripts/deploy/cli.ts"
  },
  "devDependencies": {
    "@dp/core": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.3",
    "deno": "2.9.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.14",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
