# =====================================================================================
# Environment variables. Copy what you need; NEVER commit real values.
# Local development generates everything with:  pnpm stack:env
# =====================================================================================

# -------------------------------------------------------------------------------------
# BROWSER-SAFE (frontend build, apps/web/.env.local or the hosting build settings).
# Anything prefixed VITE_ is embedded into the public JavaScript bundle.
# Only these two values may ever be VITE_ variables.
# -------------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key — public by design, protected by RLS>

# -------------------------------------------------------------------------------------
# SERVER-ONLY: Edge Function secrets (`supabase secrets set ...`).
# Must NEVER be prefixed with VITE_ and never reach the browser.
# `pnpm security:scan-bundle` fails the build if any of them appears in dist/.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase
# into Edge Functions automatically on the hosted platform.
# -------------------------------------------------------------------------------------
APP_URL=https://app.example.com                 # frontend origin (manifest, links, ICS)
ALLOWED_ORIGINS=https://app.example.com         # exact CORS allowlist, comma separated
ACCESS_TOKEN_SECRET=<random, >= 32 chars>       # HMAC key for booking tokens / device keys
TRUSTED_PROXY_HOPS=1                            # X-Forwarded-For hops added by the platform
PUBLIC_STORAGE_URL=                             # optional CDN/custom domain for Storage URLs

# Web Push (VAPID). Generate once: pnpm push:vapid
VAPID_PUBLIC_KEY=<base64url, 65-byte P-256 point — may be shown to browsers>
VAPID_PRIVATE_KEY=<base64url, 32 bytes — SECRET>
VAPID_SUBJECT=mailto:ops@example.com

# Cron -> notify-dispatcher shared secret (also stored in Vault as `dispatcher_secret`)
DISPATCHER_SECRET=<random, >= 24 chars>

# AI assistant (optional; booking works without it)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# -------------------------------------------------------------------------------------
# SERVER-ONLY: operator machine / CI (tenant pipeline, migrations, deploy).
# -------------------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key — bypasses RLS, SECRET>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_ACCESS_TOKEN=<personal access token for the Supabase CLI>
TENANT_DEMO_OWNER_PASSWORD=<password for owners of DEMO studios only>
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
